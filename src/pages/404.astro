---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found (404)" currentPath="/404">
  <div class="max-w-xl mx-auto py-20 text-center">
    <div class="inline-block p-3 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-mono text-2xl font-bold mb-4">
      404
    </div>

    <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
      Document or App Not Found
    </h1>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">
      The legal document, policy, or application you are looking for does not exist or has been moved.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-medium px-4 py-2 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity"
    >
      <span>← Return to All Applications</span>
    </a>
  </div>
</BaseLayout>
