---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Document Not Found (404)">
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="w-20 h-20 mx-auto rounded-3xl bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 flex items-center justify-center text-3xl font-extrabold text-slate-800 dark:text-zinc-200 shadow-sm mb-6">
      404
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-zinc-100 mb-3">
      Legal Document or App Not Found
    </h1>

    <p class="text-sm text-slate-600 dark:text-zinc-400 mb-8 leading-relaxed">
      The legal document, policy, or application you are looking for does not exist, has been retired, or the URL might be mistyped.
    </p>

    <div class="flex items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 text-sm font-semibold transition-colors shadow-sm"
      >
        Return to Legal Center Home
      </a>
    </div>
  </div>
</BaseLayout>

