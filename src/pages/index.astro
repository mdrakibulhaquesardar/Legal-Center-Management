---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getActiveApps } from '../lib/apps';
import { siteConfig } from '../config/site';

const activeApps = getActiveApps();
const totalDocs = activeApps.reduce((acc, curr) => acc + curr.documents.length, 0);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <!-- Hero Section -->
  <section class="border-b border-slate-200 dark:border-zinc-800 bg-gradient-to-b from-slate-50 to-white dark:from-zinc-900/40 dark:to-zinc-950 py-16 sm:py-20 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
        <span>Google Play Verified Legal Center</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-zinc-50 mb-4 sm:mb-6">
        App Privacy, Terms & Compliance
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-8">
        Permanent, centralized legal repository for applications developed by <span class="font-medium text-slate-800 dark:text-zinc-200">{siteConfig.developerName}</span>. Find official Privacy Policies, Terms of Service, and Data Deletion guidelines below.
      </p>

      <!-- Stats Bar -->
      <div class="inline-flex items-center justify-center gap-8 py-3 px-6 rounded-2xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-sm text-xs sm:text-sm">
        <div>
          <span class="font-bold text-slate-900 dark:text-zinc-100">{activeApps.length}</span>
          <span class="text-slate-500 dark:text-zinc-400 ml-1">Active Apps</span>
        </div>
        <div class="h-4 w-px bg-slate-200 dark:bg-zinc-800"></div>
        <div>
          <span class="font-bold text-slate-900 dark:text-zinc-100">{totalDocs}</span>
          <span class="text-slate-500 dark:text-zinc-400 ml-1">Legal Policies</span>
        </div>
        <div class="h-4 w-px bg-slate-200 dark:bg-zinc-800"></div>
        <div>
          <span class="font-bold text-emerald-600 dark:text-emerald-400">100%</span>
          <span class="text-slate-500 dark:text-zinc-400 ml-1">Static & Secure</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Applications Directory -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Live Search Bar -->
    <SearchBar />

    <!-- Application Grid -->
    {activeApps.length > 0 ? (
      <div id="apps-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {activeApps.map((appData) => (
          <AppCard appData={appData} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 px-4 bg-slate-50 dark:bg-zinc-900/50 rounded-2xl border border-dashed border-slate-300 dark:border-zinc-800">
        <p class="text-base font-medium text-slate-700 dark:text-zinc-300 mb-1">
          No applications registered yet
        </p>
        <p class="text-xs text-slate-500 dark:text-zinc-400">
          Add an application folder to <code class="font-mono bg-slate-200 dark:bg-zinc-800 px-1.5 py-0.5 rounded">apps/&lt;app-slug&gt;/app.json</code> to display it here.
        </p>
      </div>
    )}

    <!-- Empty Search State -->
    <div id="empty-search-state" class="hidden text-center py-16 px-4">
      <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-zinc-800 flex items-center justify-center text-slate-400 mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-base font-medium text-slate-800 dark:text-zinc-200">
        No matching applications found
      </p>
      <p class="text-xs text-slate-500 dark:text-zinc-400 mt-1">
        Try adjusting your keywords or clearing the search filter.
      </p>
    </div>
  </section>
</BaseLayout>

