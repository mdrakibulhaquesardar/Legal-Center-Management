---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getActiveApps } from '../lib/apps';
import { siteConfig } from '../config/site';
import { url } from '../lib/paths';

const activeApps = getActiveApps();
const totalDocs = activeApps.reduce((acc, curr) => acc + curr.documents.length, 0);
const currentPath = url('/');
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} currentPath={currentPath}>
  <div class="max-w-4xl py-2">
    <!-- Intro / Header -->
    <div class="mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Google Play Compliance • Active Documentation</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">
        Applications Legal Directory
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        Official, permanent legal documentation repository for Android and Flutter applications developed by <span class="font-medium text-slate-900 dark:text-white">{siteConfig.developerName}</span>. Select any application below to review its Privacy Policy, Terms of Service, or Data Deletion guidelines.
      </p>

      <!-- Quick Metrics Bar -->
      <div class="flex items-center gap-6 mt-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <div>
          <span class="font-bold text-slate-900 dark:text-white">{activeApps.length}</span> Applications
        </div>
        <span>•</span>
        <div>
          <span class="font-bold text-slate-900 dark:text-white">{totalDocs}</span> Documents
        </div>
        <span>•</span>
        <div>
          Static Generation (SSG)
        </div>
      </div>
    </div>

    <!-- Search Bar -->
    <SearchBar />

    <!-- Application Grid -->
    {activeApps.length > 0 ? (
      <div id="apps-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {activeApps.map((appData) => (
          <AppCard appData={appData} />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 px-4 rounded-xl border border-dashed border-slate-200 dark:border-slate-800">
        <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
          No applications registered yet
        </p>
      </div>
    )}

    <!-- Empty Search State -->
    <div id="empty-search-state" class="hidden text-center py-12 px-4">
      <p class="text-base font-semibold text-slate-900 dark:text-white">
        No matching applications found
      </p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Try adjusting your search query or clear the filter.
      </p>
    </div>
  </div>
</BaseLayout>
