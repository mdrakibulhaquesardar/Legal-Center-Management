---
import { getActiveApps } from '../lib/apps';
import { formatDocTitle } from '../lib/documents';

interface Props {
  currentPath?: string;
  currentAppSlug?: string;
}

const { currentPath = '/', currentAppSlug } = Astro.props;

// If we are on an app page, show ONLY that app.
// If on home, show all applications without any "OVERVIEW" section.
const allApps = getActiveApps();
const activeApps = currentAppSlug
  ? allApps.filter((a) => a.app.slug === currentAppSlug)
  : allApps;
---

<aside id="doc-sidebar" class="w-64 flex-shrink-0 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b0f17] h-[calc(100vh-3.5rem)] sticky top-14 overflow-y-auto py-5 px-4 no-print hidden md:block">
  <nav aria-label="Documentation Navigation" class="space-y-5 text-sm">
    <!-- If on an app document page, show a clean Back to All Apps link -->
    {currentAppSlug && (
      <div class="pb-3 border-b border-slate-200 dark:border-slate-800">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors"
        >
          <span>←</span>
          <span>All Applications</span>
        </a>
      </div>
    )}

    <!-- App Section: On app doc page, ONLY this app's docs are shown -->
    {activeApps.map(({ app, documents }) => (
      <div>
        <div class="flex items-center gap-2 px-2 mb-2">
          {app.icon && (
            <img src={app.icon} alt="" class="w-4 h-4 rounded object-cover flex-shrink-0" />
          )}
          <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 truncate">
            {app.name}
          </span>
        </div>

        <ul class="space-y-0.5 border-l border-slate-200 dark:border-slate-800 ml-2 pl-2">
          {documents.map((doc) => {
            const docPath = `/${app.slug}/${doc.slug}`;
            const isActive = currentPath === docPath || currentPath === `${docPath}/`;

            return (
              <li>
                <a
                  href={docPath}
                  class:list={[
                    "block py-1.5 px-2.5 rounded-md transition-colors text-xs font-medium",
                    isActive
                      ? "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold"
                      : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/40"
                  ]}
                >
                  {doc.title || formatDocTitle(doc.slug)}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<!-- Mobile Navigation Drawer Overlay -->
<div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden md:hidden no-print"></div>

<aside id="mobile-sidebar" class="fixed inset-y-0 left-0 w-72 bg-white dark:bg-[#0b0f17] border-r border-slate-200 dark:border-slate-800 z-50 p-5 overflow-y-auto transform -translate-x-full transition-transform duration-200 ease-in-out md:hidden no-print">
  <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-5">
    <span class="font-bold text-sm text-slate-900 dark:text-white">
      {currentAppSlug ? 'App Legal Docs' : 'Applications'}
    </span>
    <button id="close-mobile-menu" type="button" class="p-1 rounded text-slate-500 hover:text-slate-900 dark:hover:text-white" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="space-y-5 text-sm">
    {currentAppSlug && (
      <div class="pb-3 border-b border-slate-200 dark:border-slate-800">
        <a href="/" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center gap-1">
          <span>←</span>
          <span>All Applications</span>
        </a>
      </div>
    )}

    {activeApps.map(({ app, documents }) => (
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-2">
          {app.name}
        </h2>
        <ul class="space-y-1 pl-2 border-l border-slate-200 dark:border-slate-800">
          {documents.map((doc) => (
            <li>
              <a
                href={`/${app.slug}/${doc.slug}`}
                class="block py-1 px-2 text-xs text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400"
              >
                {doc.title || formatDocTitle(doc.slug)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script is:inline>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMobileMenuBtn = document.getElementById('close-mobile-menu');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  const mobileBackdrop = document.getElementById('mobile-sidebar-backdrop');

  function openMobileMenu() {
    mobileSidebar?.classList.remove('-translate-x-full');
    mobileBackdrop?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    mobileSidebar?.classList.add('-translate-x-full');
    mobileBackdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  closeMobileMenuBtn?.addEventListener('click', closeMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);
</script>
