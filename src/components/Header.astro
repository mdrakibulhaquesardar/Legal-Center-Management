---
import { siteConfig } from '../config/site';
import astroLogo from '../assets/astro.svg';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-white/[0.08] bg-[#0d0f14]/80 backdrop-blur-xl transition-all no-print">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <!-- Astro Gradient Icon Glow -->
      <div class="relative flex items-center justify-center">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-[#3245ff] to-[#bc52ee] opacity-60 blur-sm group-hover:opacity-100 transition duration-300"></div>
        <div class="relative w-9 h-9 rounded-xl bg-[#13161c] border border-white/10 flex items-center justify-center p-1.5 shadow-md">
          <img src={astroLogo.src} alt="Astro" class="w-full h-full object-contain" />
        </div>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-white text-base sm:text-lg tracking-tight group-hover:text-purple-300 transition-colors">
            {siteConfig.developerName}
          </span>
          <span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-300 border border-purple-500/30">
            Legal
          </span>
        </div>
        <span class="block text-xs text-zinc-400 font-normal">
          Compliance & Document Portal
        </span>
      </div>
    </a>

    <!-- Navigation & Links -->
    <nav class="flex items-center gap-3 sm:gap-6">
      <a
        href="/"
        class:list={[
          "text-sm font-medium transition-colors hover:text-white",
          currentPath === "/" ? "text-purple-400 font-semibold" : "text-zinc-400"
        ]}
      >
        Applications
      </a>

      {siteConfig.websiteUrl && (
        <a
          href={siteConfig.websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-zinc-400 hover:text-white transition-colors"
        >
          <span>Studio</span>
          <span class="text-xs opacity-60">↗</span>
        </a>
      )}

      <!-- Astro Gradient Primary Action -->
      {siteConfig.playStoreUrl && (
        <a
          href={siteConfig.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-1.5 rounded-lg text-white bg-gradient-to-r from-[#3245ff] to-[#bc52ee] hover:opacity-95 shadow-[0_0_20px_-3px_rgba(188,82,238,0.4)] transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <span>Play Store</span>
          <span>↗</span>
        </a>
      )}
    </nav>
  </div>
</header>
