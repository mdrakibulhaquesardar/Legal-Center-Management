---
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const homeUrl = url('/');
const isHome = currentPath === homeUrl || currentPath === '/' || currentPath === homeUrl.slice(0, -1);
---

<header class="sticky top-0 z-30 w-full bg-white/90 dark:bg-[#0b0f17]/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
    <!-- Brand Title & Mobile Toggle -->
    <div class="flex items-center gap-3">
      <!-- Mobile sidebar toggle button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none"
        aria-label="Open documentation sidebar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <a href={homeUrl} class="flex items-center gap-2.5 group">
        <span class="w-7 h-7 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 flex items-center justify-center font-bold text-xs shadow-sm">
          §
        </span>
        <div class="flex items-baseline gap-2">
          <span class="font-semibold text-slate-900 dark:text-slate-100 text-base tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            {siteConfig.developerName}
          </span>
          <span class="hidden sm:inline-block text-xs font-mono text-slate-500 dark:text-slate-400">
            / Legal Center
          </span>
        </div>
      </a>
    </div>

    <!-- Right Side Actions & Theme Toggle -->
    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href={homeUrl}
        class:list={[
          "text-xs sm:text-sm font-medium px-2.5 py-1 rounded-md transition-colors",
          isHome
            ? "text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800"
            : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        ]}
      >
        All Apps
      </a>

      {siteConfig.githubUrl && (
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          <span>GitHub</span>
          <span class="text-[10px]">↗</span>
        </a>
      )}

      {siteConfig.playStoreUrl && (
        <a
          href={siteConfig.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          <span>Google Play</span>
          <span class="text-[10px]">↗</span>
        </a>
      )}

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-800 mx-1"></div>

      <ThemeToggle />
    </div>
  </div>
</header>
