---
// SearchBar.astro (Astro Documentation Theme)
---

<div class="w-full max-w-xl mx-auto mb-12 no-print">
  <div class="relative group">
    <!-- Subtle glow behind input on focus -->
    <div class="absolute -inset-0.5 rounded-2xl bg-gradient-to-r from-[#3245ff] to-[#bc52ee] opacity-0 group-focus-within:opacity-40 blur-md transition duration-300"></div>

    <div class="relative flex items-center">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-zinc-400 group-focus-within:text-purple-400 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <input
        id="search-input"
        type="search"
        placeholder="Filter applications by name, keyword, or package ID..."
        autocomplete="off"
        class="w-full pl-12 pr-24 py-3.5 text-sm rounded-xl border border-white/10 bg-[#13161c]/90 text-white placeholder-zinc-500 shadow-2xl focus:outline-none focus:border-purple-500/50 transition-all backdrop-blur-xl"
      />

      <!-- Shortcut Badge -->
      <div class="absolute right-3.5 flex items-center gap-1.5 pointer-events-none">
        <kbd class="hidden sm:inline-block px-2 py-0.5 text-[10px] font-mono text-zinc-400 bg-white/[0.06] border border-white/10 rounded">
          /
        </kbd>
      </div>

      <button
        id="search-clear"
        type="button"
        class="hidden absolute right-10 pr-2 flex items-center text-zinc-400 hover:text-white"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="search-status" class="mt-2.5 text-xs text-zinc-400 px-2 flex justify-between items-center font-mono">
    <span id="match-count"></span>
  </div>
</div>

<script is:inline>
  const searchInput = document.getElementById('search-input');
  const searchClear = document.getElementById('search-clear');
  const matchCount = document.getElementById('match-count');
  const appCards = document.querySelectorAll('.app-card');
  const emptyState = document.getElementById('empty-search-state');

  function performSearch() {
    const query = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    if (query.length > 0) {
      searchClear?.classList.remove('hidden');
    } else {
      searchClear?.classList.add('hidden');
    }

    appCards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const pkg = card.getAttribute('data-package') || '';
      const desc = card.getAttribute('data-desc') || '';

      const matches = name.includes(query) || pkg.includes(query) || desc.includes(query);

      if (matches) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (query) {
      matchCount.textContent = `Showing ${visibleCount} of ${appCards.length} applications`;
    } else {
      matchCount.textContent = `Directory: ${appCards.length} live apps`;
    }

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Keyboard shortcut '/' to focus search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  if (matchCount) {
    matchCount.textContent = `Directory: ${appCards.length} live apps`;
  }

  searchInput?.addEventListener('input', performSearch);
  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    performSearch();
    searchInput.focus();
  });
</script>
