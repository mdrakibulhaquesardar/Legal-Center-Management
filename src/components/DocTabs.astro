---
import type { DocumentMetadata } from '../lib/types';
import { formatDocTitle } from '../lib/documents';
import { url } from '../lib/paths';

interface Props {
  appSlug: string;
  currentDocSlug: string;
  allDocs: DocumentMetadata[];
}

const { appSlug, currentDocSlug, allDocs } = Astro.props;
---

<div class="border-b border-slate-200 dark:border-slate-800 pb-3 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 no-print">
  <!-- Document Switcher Pills -->
  <div class="flex flex-wrap items-center gap-1.5">
    {allDocs.map((doc) => {
      const isActive = doc.slug === currentDocSlug;
      return (
        <a
          href={url(`/${appSlug}/${doc.slug}`)}
          class:list={[
            "px-3 py-1 rounded-md text-xs font-medium transition-colors border",
            isActive
              ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 border-slate-900 dark:border-slate-100 font-semibold"
              : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-slate-400"
          ]}
        >
          {doc.title || formatDocTitle(doc.slug)}
        </a>
      );
    })}
  </div>

  <!-- Print Button -->
  <button
    type="button"
    onclick="window.print()"
    class="inline-flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors self-start sm:self-auto"
  >
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
    </svg>
    <span>Print / PDF</span>
  </button>
</div>
