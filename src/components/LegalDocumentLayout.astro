---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocTabs from './DocTabs.astro';
import type { AppMetadata, DocumentMetadata } from '../lib/types';
import { formatDocTitle } from '../lib/documents';
import { siteConfig } from '../config/site';
import { url } from '../lib/paths';

interface Props {
  app: AppMetadata;
  doc: DocumentMetadata;
  allDocs: DocumentMetadata[];
}

const { app, doc, allDocs } = Astro.props;

const docTitle = doc.title || formatDocTitle(doc.slug);
const pageTitle = `${docTitle} - ${app.name}`;
const pageDescription = `${docTitle} for ${app.name} (${app.packageName || 'Mobile Application'}). Managed by ${app.developer || siteConfig.developerName}.`;
const currentPath = url(`/${app.slug}/${doc.slug}`);
const homeUrl = url('/');
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  currentAppSlug={app.slug}
>
  <div class="max-w-4xl mx-auto py-2">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mb-4 no-print">
      <a href={homeUrl} class="hover:text-slate-900 dark:hover:text-white transition-colors">
        Legal Center
      </a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300">
        {app.name}
      </span>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">
        {docTitle}
      </span>
    </nav>

    <!-- Document Header Info Box -->
    <header class="mb-6 p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center overflow-hidden border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1">
          {app.icon ? (
            <img src={url(app.icon)} alt={`${app.name} icon`} class="w-full h-full object-contain" />
          ) : (
            <span class="text-lg font-bold text-slate-700 dark:text-slate-300">
              {app.name.charAt(0).toUpperCase()}
            </span>
          )}
        </div>

        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            {app.name}
          </h1>
          <div class="flex flex-wrap items-center gap-2 mt-0.5 text-xs text-slate-600 dark:text-slate-400 font-mono">
            {app.packageName && (
              <span class="bg-white dark:bg-slate-800 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700 font-medium text-slate-800 dark:text-slate-200">
                {app.packageName}
              </span>
            )}
            <span>•</span>
            <span>Developer: {app.developer || siteConfig.developerName}</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:items-end gap-1 text-xs text-slate-600 dark:text-slate-400">
        {doc.lastUpdated && (
          <span class="font-mono font-medium text-slate-800 dark:text-slate-200">
            Updated: {doc.lastUpdated}
          </span>
        )}
        {app.email && (
          <a href={`mailto:${app.email}`} class="text-blue-600 dark:text-blue-400 hover:underline">
            {app.email}
          </a>
        )}
      </div>
    </header>

    <!-- Sibling Document Navigation Tabs -->
    <DocTabs appSlug={app.slug} currentDocSlug={doc.slug} allDocs={allDocs} />

    <!-- Print Only Header -->
    <div class="print-only mb-6 border-b border-black pb-2">
      <h2 class="text-xl font-bold">{app.name} - {docTitle}</h2>
      <p class="text-sm">Package ID: {app.packageName || 'N/A'}</p>
      {doc.lastUpdated && <p class="text-sm">Effective: {doc.lastUpdated}</p>}
    </div>

    <!-- Article Content: High-contrast text ensured in light and dark mode -->
    <article
      class="legal-article prose prose-slate dark:prose-invert max-w-none text-slate-900 dark:text-slate-100 leading-relaxed"
      set:html={doc.htmlContent}
    />

    <!-- Bottom Navigation -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 no-print">
      <a href={homeUrl} class="hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1 font-medium">
        <span>←</span>
        <span>Back to All Applications</span>
      </a>

      <button type="button" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" class="hover:text-slate-900 dark:hover:text-white transition-colors">
        Top ↑
      </button>
    </div>
  </div>
</BaseLayout>
