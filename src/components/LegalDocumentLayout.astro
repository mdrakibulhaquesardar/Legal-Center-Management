---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocTabs from './DocTabs.astro';
import type { AppMetadata, DocumentMetadata } from '../lib/types';
import { formatDocTitle } from '../lib/documents';
import { siteConfig } from '../config/site';

interface Props {
  app: AppMetadata;
  doc: DocumentMetadata;
  allDocs: DocumentMetadata[];
}

const { app, doc, allDocs } = Astro.props;

const docTitle = doc.title || formatDocTitle(doc.slug);
const pageTitle = `${docTitle} - ${app.name}`;
const pageDescription = `${docTitle} for ${app.name} (${app.packageName || 'Mobile Application'}). Managed by ${app.developer || siteConfig.developerName}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs (Hidden on print) -->
    <nav class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-6 no-print">
      <a href="/" class="hover:text-purple-300 transition-colors">
        Legal Center
      </a>
      <span class="text-zinc-600">/</span>
      <span class="text-zinc-300 font-medium">
        {app.name}
      </span>
      <span class="text-zinc-600">/</span>
      <span class="text-purple-300 font-semibold">
        {docTitle}
      </span>
    </nav>

    <!-- App Info Header (Astro Frosted Glass Card) -->
    <header class="mb-8 p-6 sm:p-7 astro-card rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-2xl flex-shrink-0 flex items-center justify-center overflow-hidden border border-white/10 bg-[#181b22] shadow-inner p-1.5">
          {app.icon ? (
            <img src={app.icon} alt={`${app.name} icon`} class="w-full h-full object-contain rounded-xl" />
          ) : (
            <span class="text-2xl font-bold bg-gradient-to-br from-white to-zinc-400 bg-clip-text text-transparent">
              {app.name.charAt(0).toUpperCase()}
            </span>
          )}
        </div>

        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            {app.name}
          </h1>
          <div class="flex flex-wrap items-center gap-2 mt-1.5 text-xs text-zinc-400 font-mono">
            {app.packageName && (
              <span class="bg-white/[0.06] text-purple-200 px-2.5 py-0.5 rounded-md border border-white/10">
                {app.packageName}
              </span>
            )}
            <span>•</span>
            <span>By {app.developer || siteConfig.developerName}</span>
          </div>
        </div>
      </div>

      <!-- App Metadata Links / Support -->
      <div class="flex flex-col sm:items-end gap-2 text-xs text-zinc-400">
        {doc.lastUpdated && (
          <div class="inline-flex items-center gap-1.5 font-mono text-xs px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Effective: {doc.lastUpdated}</span>
          </div>
        )}
        {app.email && (
          <a
            href={`mailto:${app.email}`}
            class="text-purple-400 hover:text-purple-300 hover:underline transition-colors"
          >
            {app.email}
          </a>
        )}
        {app.website && (
          <a
            href={app.website}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-white transition-colors"
          >
            App Website ↗
          </a>
        )}
      </div>
    </header>

    <!-- Document Navigation Tabs -->
    <DocTabs appSlug={app.slug} currentDocSlug={doc.slug} allDocs={allDocs} />

    <!-- Print Header Only -->
    <div class="print-only mb-6 border-b border-black pb-3">
      <h2 class="text-xl font-bold">{app.name} - {docTitle}</h2>
      <p class="text-sm">Package ID: {app.packageName || 'N/A'}</p>
      {doc.lastUpdated && <p class="text-sm">Effective / Last Updated: {doc.lastUpdated}</p>}
      <p class="text-sm">Developer: {app.developer || siteConfig.developerName} ({app.email || siteConfig.developerEmail})</p>
    </div>

    <!-- Document Content Rendered as Safe Markdown HTML -->
    <div class="astro-card p-6 sm:p-10 rounded-3xl">
      <article
        class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-purple-400 hover:prose-a:text-purple-300 prose-img:rounded-2xl leading-relaxed text-zinc-300"
        set:html={doc.htmlContent}
      />
    </div>

    <!-- Bottom Navigation Bar (Hidden on print) -->
    <div class="mt-12 pt-6 border-t border-white/[0.08] flex items-center justify-between no-print">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors group"
      >
        <span class="group-hover:-translate-x-1 transition-transform" aria-hidden="true">←</span>
        <span>Return to All Applications</span>
      </a>

      <button
        type="button"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="text-xs font-mono text-zinc-500 hover:text-purple-300 transition-colors"
      >
        Back to top ↑
      </button>
    </div>
  </div>
</BaseLayout>
