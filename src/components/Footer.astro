---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-zinc-800 bg-slate-50/50 dark:bg-zinc-900/40 transition-colors no-print">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-slate-500 dark:text-zinc-400">
      <div class="flex flex-col items-center md:items-start gap-1">
        <p class="font-medium text-slate-700 dark:text-zinc-300">
          {siteConfig.developerName}
        </p>
        <p class="text-xs">
          © {currentYear} All rights reserved. Permanent legal document repository.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-xs">
        {siteConfig.developerEmail && (
          <a
            href={`mailto:${siteConfig.developerEmail}`}
            class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors"
          >
            Contact: {siteConfig.developerEmail}
          </a>
        )}
        {siteConfig.playStoreUrl && (
          <a
            href={siteConfig.playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors"
          >
            Google Play Developer Profile ↗
          </a>
        )}
        <a
          href="#"
          class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors"
        >
          ↑ Back to Top
        </a>
      </div>
    </div>
  </div>
</footer>

