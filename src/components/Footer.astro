---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0b0f17] text-xs text-slate-500 dark:text-slate-400 py-6 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="font-medium text-slate-800 dark:text-slate-200">{siteConfig.developerName}</span>
      <span>•</span>
      <span>Legal Documentation Portal</span>
    </div>

    <div class="flex items-center gap-6">
      {siteConfig.developerEmail && (
        <a href={`mailto:${siteConfig.developerEmail}`} class="hover:text-slate-900 dark:hover:text-white transition-colors">
          {siteConfig.developerEmail}
        </a>
      )}
      <span>© {currentYear}</span>
      <a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
